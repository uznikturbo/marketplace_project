# Copy this file to .env and fill in real values.
# The .env file is ignored by git and must never be committed.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Settings module. manage.py defaults to marketplace.settings.dev,
# WSGI/ASGI/Celery default to marketplace.settings.prod.
# DJANGO_SETTINGS_MODULE=marketplace.settings.dev

# Production-only security flags (marketplace.settings.prod). Keep the safe
# defaults unless you are still setting up TLS.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True

# Optional: where the rotation task stores the key.
# Leave empty to use marketplace/.secret_key.
DJANGO_SECRET_KEY_FILE=

# Rotate the secret key every N days with Celery beat. 0 disables rotation.
SECRET_KEY_ROTATION_DAYS=7

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=marketplace_db
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# Nova Poshta (https://api.novaposhta.ua)
# ---------------------------------------------------------------------------
NOVAPOST_API=

# ---------------------------------------------------------------------------
# LiqPay (https://www.liqpay.ua)
# ---------------------------------------------------------------------------
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# SMS provider (optional)
# When SMS_API_URL is empty, confirmation codes are written to the log
# instead of being sent, which is convenient for local development.
# ---------------------------------------------------------------------------
SMS_API_URL=
SMS_API_KEY=
